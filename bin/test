#!/bin/bash -e
test "$#" -gt 1 && echo "Unsupported args: $@" >&2 && exit 145
cd "$( dirname "${BASH_SOURCE[0]}" )"/..

TESTER=${1:-tester}

export COMPOSE_FILE=spec/docker-compose.yml
export COMPOSE_PROJECT_NAME=act-fluent-logger-rails_dev

docker compose --compatibility rm -svf
docker compose --compatibility build --force-rm
docker compose --compatibility run --rm --remove-orphans "$TESTER" && docker compose --compatibility rm -svf || docker compose --compatibility logs
